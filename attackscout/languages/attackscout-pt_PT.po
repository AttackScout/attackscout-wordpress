msgstr "%1$s: %2$d"

msgid "Deadlines"
msgstr "Prazos"

msgid "How to fix these points"
msgstr "Como corrigir estes pontos"

msgid "Monitor this site and get deadline alerts"
msgstr "Monitorizar este site e receber alertas de prazos"

